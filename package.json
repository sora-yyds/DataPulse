{
  "name": "@datapulse/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0",
    "corepack": "0.35.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check:aggregators": "node ./scripts/check-aggregators.mjs --self-test",
    "check:design": "node ./scripts/check-design.mjs --self-test",
    "check:dependencies": "node ./tests/architecture/check-dependencies.mjs --self-test",
    "check:evidence": "node ./scripts/check-m0-evidence.mjs --self-test",
    "check:foundation": "node ./scripts/check-foundation.mjs",
    "check:governance": "node ./tests/governance/check-repository-governance.mjs --self-test",
    "check:workspace": "turbo run build && node ./tests/architecture/check-workspace.mjs",
    "check:toolchain": "turbo run check:toolchain:root",
    "check:toolchain:root": "node ./scripts/check-toolchain.mjs",
    "verify:m0": "node ./scripts/verify.mjs m0",
    "verify:pr": "node ./scripts/verify.mjs pr"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@google/design.md": "0.4.0",
    "ajv": "8.17.1",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  }
}
