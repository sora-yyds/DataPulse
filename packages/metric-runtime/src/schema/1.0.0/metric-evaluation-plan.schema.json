{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datapulse:metric-evaluation-plan:1.0.0",
  "title": "DataPulse MetricEvaluationPlan 1.0.0",
  "description": "A single trusted metric identity and aggregate evaluated over selected accumulators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metricId",
    "aggregate"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "metricId": {
      "type": "string",
      "pattern": "^(?=.{8,71}$)metric_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aggregate": {
      "enum": [
        "COUNT_ROWS",
        "SUM"
      ]
    }
  }
}
