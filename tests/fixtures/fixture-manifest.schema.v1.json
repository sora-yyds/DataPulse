{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datapulse:fixture-manifest:1.0.0",
  "title": "DataPulse fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "hashAlgorithm",
    "catalog",
    "fixtureSets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "datapulse-fixture-manifest"
    },
    "hashAlgorithm": {
      "const": "SHA-256"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalFixtureSets",
        "artifacts",
        "generatedFixtureSets"
      ],
      "properties": {
        "logicalFixtureSets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "artifacts": {
          "type": "integer",
          "minimum": 1
        },
        "generatedFixtureSets": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fixtureSets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/fixtureSet"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "fixedSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "fixed"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$"
        }
      }
    },
    "notApplicableSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "not-applicable"
        }
      }
    },
    "generation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "generator",
            "seed"
          ],
          "properties": {
            "mode": {
              "const": "hand-authored"
            },
            "generator": {
              "$ref": "#/$defs/generator"
            },
            "seed": {
              "$ref": "#/$defs/notApplicableSeed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "generator",
            "seed",
            "generatorFile"
          ],
          "properties": {
            "mode": {
              "const": "generated"
            },
            "generator": {
              "$ref": "#/$defs/generator"
            },
            "seed": {
              "$ref": "#/$defs/fixedSeed"
            },
            "generatorFile": {
              "$ref": "#/$defs/identity"
            }
          }
        }
      ]
    },
    "expectedAssertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "outcome",
            "value"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            },
            "outcome": {
              "const": "equals"
            },
            "value": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "outcome",
            "errorCode"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            },
            "outcome": {
              "const": "rejected"
            },
            "errorCode": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
            }
          }
        }
      ]
    },
    "fixtureSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "dataOrigin",
        "generation",
        "expectedAssertions",
        "subManifestKind",
        "subManifest",
        "artifacts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "dataOrigin": {
          "const": "synthetic"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "expectedAssertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/expectedAssertion"
          }
        },
        "subManifestKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subManifest": {
          "$ref": "#/$defs/identity"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/artifactIdentity"
          }
        }
      }
    }
  }
}
